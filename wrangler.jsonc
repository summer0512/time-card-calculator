{
  "$schema": "node_modules/wrangler/config-schema.json",

  "name": "time-card-calculator",

  "main": ".open-next/worker.js",

  "compatibility_date": "2026-08-26",

  "compatibility_flags": [
    "nodejs_compat"
  ],

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  "observability": {
    "enabled": true
  }
}